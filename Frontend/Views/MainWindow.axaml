<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Frontend.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Frontend.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Frontend.Views.MainWindow"
        Icon="/Assets/homm-logo.ico"
        Title="HOMM V Army Calculator">
	<Grid RowDefinitions="Auto,*">
		<views:MainView Grid.Row="0"/>
		<views:CreaturesView Grid.Row="1"/>
	</Grid>
</Window>
